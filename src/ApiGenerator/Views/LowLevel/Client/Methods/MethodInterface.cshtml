@using ApiGenerator.Domain.Code.LowLevel
@using ApiGenerator.Generator
@inherits global::ApiGenerator.CodeTemplatePage<LowLevelClientMethod>

@{await IncludeAsync("LowLevel/Client/Methods/MethodDocs.cshtml", Model); }
        @Raw(CodeLayout.ParameterList($"TResponse {Model.PerPathMethodName}<TResponse>", Model.Arguments, 8))
            where TResponse : class, IOpenSearchResponse, new();

@{await IncludeAsync("LowLevel/Client/Methods/MethodDocs.cshtml", Model); }
        @Raw(CodeLayout.ParameterList($"Task<TResponse> {Model.PerPathMethodName}Async<TResponse>", Model.Arguments + ", CancellationToken ctx = default", 8))
            where TResponse : class, IOpenSearchResponse, new();
