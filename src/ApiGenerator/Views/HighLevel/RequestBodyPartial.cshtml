@using System
@using System.Linq
@using ApiGenerator.Domain.Code.HighLevel.Models
@inherits ApiGenerator.CodeTemplatePage<RequestModel>
@{ await IncludeGeneratorNotice(); }
@{
    var iface = Model.InterfaceName;
    var name  = Model.CsharpName;
    var descriptorName = name.EndsWith("Request")
        ? name.Substring(0, name.Length - "Request".Length) + "Descriptor"
        : name + "Descriptor";
    // A generated Func<...> selector overload (query builder or union-list builder) needs
    // System; only emit the using when at least one such property is present.
    var needsSystem = Model.Properties.Any(p =>
        p.CsharpType == "IQueryContainer"
        || (p.Type is ListType { Element: MappedType { Name: var en } } lt
            && !lt.IsNullable
            && en.StartsWith("I", StringComparison.Ordinal)
            && en.Length > 1
            && char.IsUpper(en[1])));
}
@if (needsSystem)
{
<text>using System;
</text>
}
using System.Collections.Generic;
using System.Runtime.Serialization;
using OpenSearch.Net;

namespace OpenSearch.Client
{
@if (Model.VersionAdded != null)
{
<text>    /// <remarks>Supported by OpenSearch servers of version @(Model.VersionAdded) or greater.</remarks>
</text>
}
    public partial interface @iface
    {
@foreach (var prop in Model.Properties)
{
<text>        [DataMember(Name = "@prop.WireName")]
        @Raw(prop.CsharpType) @prop.CsharpName { get; set; }
</text>
}
    }

    public partial class @name
    {
@if (Model.VersionAdded != null)
{
<text>        /// <summary>Minimum OpenSearch version required for this API.</summary>
        public const string MinimumServerVersion = "@(Model.VersionAdded)";
</text>
}
@foreach (var prop in Model.Properties)
{
<text>        public @Raw(prop.CsharpType) @prop.CsharpName { get; set; }
</text>
}
    }

    public partial class @descriptorName
    {
@foreach (var prop in Model.Properties)
{
        var propIfaceName = iface + "." + prop.CsharpName;
<text>        @Raw(prop.CsharpType) @Raw(propIfaceName) { get; set; }
</text>
}
@foreach (var prop in Model.Properties)
{
        var rawLowerParamName = char.ToLowerInvariant(prop.CsharpName[0]) + prop.CsharpName.Substring(1);
        var lowerParamName = SafeParam(rawLowerParamName);
        var defaultValue = prop.CsharpType == "bool?" ? " = true" : "";
<text>        public @descriptorName @(prop.CsharpName)(@Raw(prop.CsharpType) @(lowerParamName)@Raw(defaultValue)) =>
            Assign(@(lowerParamName), (a, v) => a.@prop.CsharpName = v);
</text>
        // Any IQueryContainer property also gets a fluent query-builder selector overload.
        if (prop.CsharpType == "IQueryContainer")
        {
            var qSig = "        public " + descriptorName + " " + prop.CsharpName
                + "(Func<QueryContainerDescriptor<object>, QueryContainer> selector) =>";
            var qBody = "            Assign(selector, (a, v) => a." + prop.CsharpName
                + " = v?.Invoke(new QueryContainerDescriptor<object>()));";
<text>        @Raw(qSig)
@Raw(qBody)
</text>
        }
        // When the property is a list of a wrapper-key union interface (e.g.
        // IList<IRequestProcessor>), also emit a fluent selector overload backed by the
        // union's collection descriptor (e.g. RequestProcessorsDescriptor), so processors
        // can be defined with a builder instead of only a pre-built list. The union element
        // resolves to a MappedType whose name is the interface (e.g. "IRequestProcessor");
        // the collection descriptor is that interface minus the leading "I" plus "sDescriptor".
        if (prop.Type is ListType { Element: MappedType { Name: var elementName } } listType
            && !listType.IsNullable
            && elementName.StartsWith("I", StringComparison.Ordinal)
            && elementName.Length > 1
            && char.IsUpper(elementName[1]))
        {
            var builderName = elementName.Substring(1) + "sDescriptor";
            var selectorSig = "public " + descriptorName + " " + prop.CsharpName
                + "(Func<" + builderName + ", IPromise<" + prop.CsharpType + ">> selector) =>";
            var selectorBody = "            Assign(selector, (a, v) => a." + prop.CsharpName
                + " = v?.Invoke(new " + builderName + "())?.Value);";
<text>        @Raw(selectorSig)
@Raw(selectorBody)
</text>
        }
}
    }
}
