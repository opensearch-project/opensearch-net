@using System
@using System.Linq
@using ApiGenerator.Domain.Code.HighLevel.Models
@inherits ApiGenerator.CodeTemplatePage<ModelType>
@{ await IncludeGeneratorNotice(); }
@{
    // Object models with an IQueryContainer property generate a Func<...> query-builder
    // selector overload, which needs System; only emit the using then.
    var needsSystem = Model is ObjectModel om
        && om.Properties.Any(p => p.CsharpType == "IQueryContainer");
}
@if (needsSystem)
{
<text>using System;
</text>
}
using System.Collections.Generic;
using System.Runtime.Serialization;
using OpenSearch.Net;
using OpenSearch.Net.Utf8Json;

namespace OpenSearch.Client
{
@if (Model is EnumModel enumModel)
{
@:    [StringEnum]
@:    public enum @enumModel.CsharpName
@:    {
    foreach (var m in enumModel.Members)
    {
@:        [EnumMember(Value = "@m.WireValue")]
@:        @m.CsharpName,
    }
@:    }
}
else if (Model is ObjectModel objectModel)
{
    var iface = objectModel.InterfaceName;
    var name  = objectModel.CsharpName;
    var descBase = $"DescriptorBase<{name}Descriptor, {iface}>";
    var isOpen = objectModel.AllowAdditionalProperties;
    if (isOpen)
    {
@:    [JsonFormatter(typeof(OpenObjectFormatter<@name, @iface>))]
@:    [ReadAs(typeof(@name))]
@:    public interface @iface : IHasAdditionalProperties
    }
    else
    {
@:    [InterfaceDataContract]
@:    [ReadAs(typeof(@name))]
@:    public interface @iface
    }
@:    {
    foreach (var p in objectModel.Properties)
    {
@:        [DataMember(Name = "@p.WireName")]
@:        @Raw(p.CsharpType) @p.CsharpName { get; set; }
    }
@:    }
@:
@:    public class @name : @iface
@:    {
    foreach (var p in objectModel.Properties)
    {
@:        public @Raw(p.CsharpType) @p.CsharpName { get; set; }
    }
    if (isOpen)
    {
@:        public IDictionary<string, object> AdditionalProperties { get; set; }
    }
@:    }
@:
@:    public class @(name)Descriptor : @Raw(descBase), @iface
@:    {
    foreach (var p in objectModel.Properties)
    {
        var ifaceProp = $"{iface}.{p.CsharpName}";
@:        @Raw(p.CsharpType) @Raw(ifaceProp) { get; set; }
    }
    if (isOpen)
    {
@:        IDictionary<string, object> IHasAdditionalProperties.AdditionalProperties { get; set; }
    }
    foreach (var p in objectModel.Properties)
    {
        var rawParamName = Char.ToLowerInvariant(p.CsharpName[0]) + p.CsharpName.Substring(1);
        var paramName = SafeParam(rawParamName);
        var paramDefault = p.CsharpType == "bool?" ? " = true" : "";
@:        public @(name)Descriptor @(p.CsharpName)(@Raw(p.CsharpType) @(paramName)@Raw(paramDefault)) =>
@:            Assign(@(paramName), (a, v) => a.@p.CsharpName = v);
        if (p.CsharpType == "IQueryContainer")
        {
            var qSig = "        public " + name + "Descriptor " + p.CsharpName
                + "(Func<QueryContainerDescriptor<object>, QueryContainer> selector) =>";
            var qBody = "            Assign(selector, (a, v) => a." + p.CsharpName
                + " = v?.Invoke(new QueryContainerDescriptor<object>()));";
@:@Raw(qSig)
@:@Raw(qBody)
        }
    }
    if (isOpen)
    {
@:        public @(name)Descriptor AdditionalProperties(IDictionary<string, object> additionalProperties) =>
@:            Assign(additionalProperties, (a, v) => ((IHasAdditionalProperties)a).AdditionalProperties = v);
    }
@:    }
}
}
