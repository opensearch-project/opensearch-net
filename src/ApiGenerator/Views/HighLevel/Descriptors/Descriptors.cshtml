@using System.Collections.ObjectModel
@using System.Linq
@using ApiGenerator
@using ApiGenerator.Configuration
@using ApiGenerator.Domain.Specification
@using ApiGenerator.Domain.Code
@using ApiGenerator.Generator.Razor
@inherits CodeTemplatePage<KeyValuePair<string, ReadOnlyCollection<ApiEndpoint>>>
@{
	var (ns, endpoints) = Model;
	var newlyGenerated = endpoints.All(e => CodeConfiguration.EnableHighLevelCodeGen.Contains(e.Name));
	var rawNs = ns;
	ns = ns != CsharpNames.RootNamespace ? $".{CsharpNames.ApiNamespace}.{ns}{CsharpNames.ApiNamespaceSuffix}" : null;
	var suppressLowLevel = ModelsGenerator.EnabledPlugins
		.Any(p => p.Namespace.ToPascalCase() == rawNs && p.SuppressLowLevelApiImport);
}
@{ if (newlyGenerated) { await IncludeGeneratorNotice(); } else { await IncludeLegacyGeneratorNotice(); } }
// ReSharper disable RedundantUsingDirective
using System;
using System.Collections.Generic;
using System.Linq;
using System.Linq.Expressions;
using System.Text;
using OpenSearch.Net;
@if (ns != null && !suppressLowLevel)
{
<text>using OpenSearch.Net@(ns);
</text>
}
using OpenSearch.Net.Utf8Json;
@if (ns != null && suppressLowLevel)
{
    var fullNs = "OpenSearch.Net" + ns;
    var paramTypes = endpoints
        .Select(e => e.CsharpNames.ParametersName)
        .Distinct()
        .OrderBy(t => t);
    foreach (var pType in paramTypes)
    {
<text>using @pType = @fullNs.@pType;
</text>
    }
}

// ReSharper disable RedundantBaseConstructorCall
// ReSharper disable UnusedTypeParameter
// ReSharper disable PartialMethodWithSinglePart
// ReSharper disable RedundantNameQualifier
namespace OpenSearch.Client
{
@{ var firstEndpoint = true; }
@foreach (var endpoint in endpoints)
{
    if (!firstEndpoint)
    {
<text>
</text>
    }
    firstEndpoint = false;
    await IncludeAsync("HighLevel/Descriptors/Descriptor.cshtml", endpoint.DescriptorPartialImplementation);
}
}
