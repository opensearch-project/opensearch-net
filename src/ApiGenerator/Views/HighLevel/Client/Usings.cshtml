@using System
@using System.Linq
@using ApiGenerator.Domain
@using ApiGenerator.Domain.Code
@inherits ApiGenerator.CodeTemplatePage<RestApiSpec>
@{
	var namespaces = Model.EndpointsPerNamespaceHighLevel.Keys.ToHashSet();
	namespaces.Remove(CsharpNames.RootNamespace);
	namespaces.Add("Http");

	var usings = namespaces
		.Select(ns => $"{CsharpNames.ApiNamespace}.{ns}{CsharpNames.ApiNamespaceSuffix}")
		.OrderBy(u => u, StringComparer.Ordinal);

	foreach (var u in usings)
	{
<text>using OpenSearch.Client.@(u);
</text>
	}
}
